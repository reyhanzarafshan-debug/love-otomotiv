# Örnek production ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp sunucuda doldurun: cp .env.production.example .env
# Gerçek .env dosyasını git'e eklemeyin (.gitignore'da olmalı)

# Zorunlu - Production'da mutlaka güçlü rastgele bir key kullanın
SECRET_KEY=your-50-char-random-secret-key-here

# Production'da False
DEBUG=False

# Virgülle ayrılmış domain listesi (boşluk kullanmayın)
ALLOWED_HOSTS=example.com,www.example.com

# HTTPS ile kullanacağınız adresler (virgülle ayrılmış)
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# İsteğe bağlı - Varsayılan: /static/ ve /media/
# STATIC_URL=/static/
# MEDIA_URL=/media/
# STATIC_ROOT=/var/www/yourproject/staticfiles
# MEDIA_ROOT=/var/www/yourproject/media

# PayTR (gerçek ödeme için doldurun; boş bırakırsanız mock mod çalışır)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=False
